# Copy to .env.local

# Contact form — enquiries are delivered through the Brevo transactional API.
# Without BREVO_API_KEY nothing is sent: the enquiry is still saved and shown
# at /admin, but nobody is notified.
BREVO_API_KEY=
# Must be a verified sender or an authenticated domain in your Brevo account.
BREVO_SENDER_EMAIL=info@humanmadelogic.fun
BREVO_SENDER_NAME=Human Made Logic
CONTACT_TO=info@humanmadelogic.fun
CONTACT_CC=kuntal@humanmadelogic.fun

# Admin panel at /admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional MCP admin token for list_inquiries (falls back to ADMIN_PASSWORD)
MCP_ADMIN_TOKEN=

# Model backends used by the ComLabs MCP `ask` tool
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
