# Copy to .env.local

# Contact form — nodemailer delivers enquiries here
CONTACT_TO=info@humanmadelogic.fun
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@humanmadelogic.fun

# Admin panel at /admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional MCP admin token for list_inquiries (falls back to ADMIN_PASSWORD)
MCP_ADMIN_TOKEN=

# Model backends used by the ComLabs MCP `ask` tool
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
