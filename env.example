# Copy to .env.local

# Contact form — enquiries are delivered over Google SMTP.
# SMTP_PASS must be a Google App Password (2-Step Verification has to be on
# for the account before one can be generated); a normal password is rejected.
# Without SMTP_USER/SMTP_PASS nothing is sent: the enquiry is still saved and
# shown at /admin, but nobody is notified.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@humanmadelogic.fun
SMTP_PASS=
# Google requires the sender to be the authenticated user or one of its
# verified "Send mail as" aliases.
SMTP_FROM=info@humanmadelogic.fun
SMTP_FROM_NAME=Human Made Logic
CONTACT_TO=info@humanmadelogic.fun
CONTACT_CC=kuntal@humanmadelogic.fun

# Admin panel at /admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional MCP admin token for list_inquiries (falls back to ADMIN_PASSWORD)
MCP_ADMIN_TOKEN=

# Model backends used by the ComLabs MCP `ask` tool
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
